    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "pg": "^8.21.0",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@admission-agency/config": "workspace:*",
    "@admission-agency/types": "workspace:*",
    "@nestjs/cli": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "eslint": "^9.39.1",
    "prisma": "^7.8.0",
    "supertest": "latest",
